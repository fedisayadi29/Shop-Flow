# ===================================

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
out/

# Kiro/Claude
.claude/
.kiro/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
*~
tags
[._]*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ===================================
# Temporary Files
# ===================================

*.tmp
*.temp
*.swp
*.swo
*.bak
*.cache
*.pid
*.seed
*.pid.lock

# ===================================
# Security & Secrets
# ===================================

# Environment variables
.env
.env.local
.env.*.local
*.env

# Secrets
secrets/
*.key
*.pem
*.p12
*.jks
*.keystore

# Credentials
credentials.json
service-account.json

# ===================================
# Documentation (Keep)
# ===================================

# Keep documentation
!docs/
!docs/**/*.md
!README.md
!LICENSE

# ===================================
# Project Specific
# ===================================

# Test data
test-data/
sample-data/

# Backup files
*.backup
backup/

# Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Exclude compiled files
*.class
*.dll
*.exe
*.o
*.so

# ===================================
# Keep Important Files
# ===================================

# Keep these files
!.gitignore
!.gitattributes
!README.md
!LICENSE
!pom.xml
!package.json
!package-lock.json
!tsconfig.json
!next.config.js
!tailwind.config.ts
